{"kind": "manifest", "version": 3, "world_id": "oldport", "name": "旧港", "engine_min": "3.11.1", "source_engine_version": "3.11.1", "summary": "海边小镇的三个人:开咖啡店的夏、做木工的遥、画画的柔", "theme": "default"}
{"kind": "author", "type": "pack", "body": {"id": "开场", "version": "1.0.0", "note": "旧港的第一周:夏、遥、柔,和门口那棵老橡树"}}
{"kind": "author", "type": "config", "body": {"needs.enabled": true, "economy.enabled": true, "social.enabled": true, "chat.stance.enabled": true, "chat.tools.enabled": true, "chat.intent.enabled": true, "autonomy.enabled": true, "chat.loop.enabled": false, "contact.enabled": true, "chat.persona_anchor.enabled": true, "memory.consolidation.enabled": true, "social.hearsay_reaction.enabled": true, "economy.player_allowance": 60.0, "needs.mood_penalty_stock": "睡眠债", "world.start_time": "14:30", "director.enabled": true}}
{"kind": "author", "type": "agent", "body": {"id": "夏", "name": "苏晚夏", "card": {"billing": "lead", "tagline": "老港咖啡的店员,记得每个人爱喝什么", "portrait": "https://example.com/anima-demo-placeholder/su-wanxia.png"}, "location": "cafe", "personality": "开朗热情，说话直接，是咖啡店里手脚麻利的店员，喜欢主动搭话、把气氛聊热", "duties": [{"name": "open_cafe", "start": "07:30", "end": "08:00", "kind": "walk", "params": {"location": "cafe"}}, {"name": "tend_oak", "start": "08:00", "end": "08:30", "kind": "interact", "params": {"target": "tree:harbor_oak", "verb": "tend"}, "when_stock": {"owner": "tree:harbor_oak", "key": "树高", "op": "<", "value": 6}}, {"name": "tend_cafe", "start": "08:00", "end": "18:30", "kind": "work", "params": {"location": "cafe"}}, {"name": "walk_home", "start": "18:30", "end": "19:00", "kind": "walk", "params": {"location": "home"}}, {"name": "night_sleep", "start": "23:00", "end": "07:30", "kind": "sleep", "params": {}}], "money": 180, "inventory": [{"item": "old_watch", "note": "从不离身"}, {"item": "garden_shears", "note": "店门口那棵橡树是她在管"}, {"item": "fertilizer", "qty": 8}], "goals": ["把店撑过这个雨季", "让每个进门的人都愿意多坐一会儿"]}}
{"kind": "author", "type": "agent", "body": {"id": "遥", "name": "陆知遥", "card": {"billing": "hidden", "tagline": "工作室的灯总亮到很晚,你还没见过他"}, "location": "workshop", "personality": "冷静知性，惜字如金，是独立设计工作室的建筑师，习惯理性分析、不轻易表露情绪", "duties": [{"name": "to_workshop", "start": "09:00", "end": "09:30", "kind": "walk", "params": {"location": "workshop"}}, {"name": "draft", "start": "09:30", "end": "20:00", "kind": "work", "params": {"location": "workshop"}}, {"name": "walk_home", "start": "20:00", "end": "20:30", "kind": "walk", "params": {"location": "home"}}, {"name": "night_sleep", "start": "00:30", "end": "09:00", "kind": "sleep", "params": {}}], "money": 240, "inventory": [{"item": "sketchbook"}], "goals": ["接到一个真正想做的项目", "少说废话,把图画好"]}}
{"kind": "author", "type": "agent", "body": {"id": "柔", "name": "沈亦柔", "card": {"billing": "supporting", "tagline": "每天下午来店里坐两个钟头的画画的人"}, "location": "home", "personality": "温柔细腻，情感丰富，喜欢窝在家里画画，说话温和、容易共情别人的心事", "duties": [{"name": "paint", "start": "10:00", "end": "15:00", "kind": "work", "params": {"location": "home"}}, {"name": "to_cafe", "start": "15:00", "end": "15:30", "kind": "walk", "params": {"location": "cafe"}}, {"name": "linger", "start": "15:30", "end": "17:30", "kind": "chat", "params": {"target": "夏"}}, {"name": "walk_home", "start": "17:30", "end": "18:00", "kind": "walk", "params": {"location": "home"}}, {"name": "night_sleep", "start": "22:30", "end": "10:00", "kind": "sleep", "params": {}}], "money": 60, "inventory": [{"item": "paint_set"}], "goals": ["画完手上这幅", "攒够下个月的颜料钱"]}}
{"kind": "author", "type": "location", "body": {"id": "oldport", "name": "旧港区", "description": "临海市的旧港区，慢，潮湿，总也下不完的雨。", "kind": "region", "parent": null, "x": 0.08, "y": 0.08, "w": 0.84, "h": 0.84}}
{"kind": "author", "type": "location", "body": {"id": "harbor_st", "name": "港街", "description": "沿着水岸的一条老街，白天有咖啡香，晚上只剩路灯。", "kind": "region", "parent": "oldport", "x": 0.05, "y": 0.08, "w": 0.55, "h": 0.5}}
{"kind": "author", "type": "location", "body": {"id": "cafe", "name": "咖啡店", "description": "港街拐角的咖啡店，手冲，木头桌子，靠窗的位置最好。", "map_image": "https://example.com/anima-demo-placeholder/cafe-map.png", "scene_image": "https://example.com/anima-demo-placeholder/cafe-scene.jpg", "kind": "point", "parent": "harbor_st", "x": 0.3, "y": 0.45, "stock": [{"item": "coffee", "qty": 12, "price": 6.0}, {"item": "sandwich", "qty": 8, "price": 12.0}, {"item": "sketchbook", "qty": 3, "price": 25.0}, {"item": "garden_shears", "qty": 2, "price": 35.0}, {"item": "fertilizer", "qty": 10, "price": 4.0}]}}
{"kind": "author", "type": "location", "body": {"id": "workshop", "name": "建筑工作室", "description": "港街尽头的独立工作室，满桌纸质草图和模型。", "map_image": "https://example.com/anima-demo-placeholder/workshop-map.png", "scene_image": "https://example.com/anima-demo-placeholder/workshop-scene.jpg", "kind": "point", "parent": "harbor_st", "x": 0.78, "y": 0.6}}
{"kind": "author", "type": "location", "body": {"id": "home", "name": "家", "description": "旧港区深处的一间屋子，画架朝着窗，颜料味散不掉。", "map_image": "https://example.com/anima-demo-placeholder/home-map.png", "scene_image": "https://example.com/anima-demo-placeholder/home-scene.jpg", "kind": "point", "parent": "oldport", "x": 0.78, "y": 0.8}}
{"kind": "author", "type": "relation", "body": {"a": "夏", "b": "遥", "sentiment": 0.35, "r_type": "常来店里的老客人", "r_type_back": "话多但让人放松的店员"}}
{"kind": "author", "type": "relation", "body": {"a": "夏", "b": "柔", "sentiment": 0.55, "r_type": "住得近的朋友", "r_type_back": "总记得我口味的人"}}
{"kind": "author", "type": "relation", "body": {"a": "遥", "b": "柔", "sentiment": 0.15, "r_type": "点头之交", "r_type_back": "在咖啡店见过几次的人"}}
{"kind": "author", "type": "memory", "body": {"agent_id": "夏", "kind": "seed", "importance": 0.7, "anchor": true, "summary": "这家咖啡店是我盘下来的,第一天只卖出去三杯,雨下了一整天。"}}
{"kind": "author", "type": "memory", "body": {"agent_id": "夏", "kind": "seed", "importance": 0.5, "summary": "陆知遥每次来都坐靠窗那个位置,点美式,不加糖。"}}
{"kind": "author", "type": "memory", "body": {"agent_id": "遥", "kind": "seed", "importance": 0.7, "anchor": true, "summary": "我辞掉了大所的工作,自己开了这间工作室,到现在还没接到第二个像样的活。"}}
{"kind": "author", "type": "memory", "body": {"agent_id": "遥", "kind": "seed", "importance": 0.5, "summary": "港街拐角那家咖啡店的手冲不错,店员话有点多。"}}
{"kind": "author", "type": "memory", "body": {"agent_id": "柔", "kind": "seed", "importance": 0.7, "anchor": true, "summary": "画了三年还是卖不掉,但停下来更难受。"}}
{"kind": "author", "type": "memory", "body": {"agent_id": "柔", "kind": "seed", "importance": 0.5, "summary": "苏晚夏总说我脸色差,给我多加一份糖。"}}
{"kind": "author", "type": "item", "body": {"id": "coffee", "name": "咖啡", "kind": "consumable", "base_price": 6.0, "restores": {"hunger": 0.15, "energy": 0.1}}}
{"kind": "author", "type": "item", "body": {"id": "sandwich", "name": "三明治", "kind": "consumable", "base_price": 12.0, "restores": {"hunger": 0.5}}}
{"kind": "author", "type": "item", "body": {"id": "sketchbook", "name": "速写本", "kind": "durable", "base_price": 25.0}}
{"kind": "author", "type": "item", "body": {"id": "paint_set", "name": "一盒颜料", "kind": "durable", "base_price": 40.0}}
{"kind": "author", "type": "item", "body": {"id": "garden_shears", "name": "园艺剪", "kind": "durable", "base_price": 35.0}}
{"kind": "author", "type": "item", "body": {"id": "fertilizer", "name": "一包肥", "kind": "consumable", "base_price": 4.0}}
{"kind": "author", "type": "item", "body": {"id": "old_watch", "name": "父亲的旧怀表", "kind": "durable", "base_price": 0.0}}
{"kind": "author", "type": "stock", "body": {"owner": "world", "values": {"季节": 2, "雨天数": 0, "雨势": 0.35}}}
{"kind": "author", "type": "stock", "body": {"owner": "tree:harbor_oak", "values": {"树高": 3.2, "生长速度": 0.004, "最大树高": 12}}}
{"kind": "author", "type": "stock", "body": {"owner": "agent:夏", "values": {"主动": 1.4, "随和": 1.4}}}
{"kind": "author", "type": "stock", "body": {"owner": "agent:遥", "values": {"主动": 0.4, "随和": 0.35}}}
{"kind": "author", "type": "rule", "body": {"id": "tree_growth", "every": {"days": 1}, "for_each": {"kind": "tree"}, "when": ["world_季节 != 4"], "set": {"树高": "min(树高 + 生长速度 * dt, 最大树高)"}, "emit": [{"when": "树高 >= 最大树高", "type": "tree_matured", "importance": 0.6, "text": "门口那棵老橡树长到头了 —— 再往上,它就不长了。"}]}}
{"kind": "author", "type": "rule", "body": {"id": "rainy_days", "every": {"days": 1}, "for_each": {"owner": "world"}, "set": {"雨天数": "雨天数 + dt / 288"}}}
{"kind": "author", "type": "rule", "body": {"id": "阵雨", "every": {"ticks": 12}, "for_each": {"owner": "world"}, "set": {"雨势": "clamp(雨势 + ((0.4 - 雨势) * 0.03 + (rand() - 0.5) * 0.06) * dt, 0.02, 1)"}, "emit": [{"when": "雨势 >= 0.8", "type": "下大了", "on": "rise", "importance": 0.45, "text": "雨忽然下大了,雨点砸在遮阳棚上,街上的人都往屋檐底下躲。"}, {"when": "雨势 >= 0.8", "type": "雨小了", "on": "fall", "importance": 0.3, "text": "雨小下去了,屋檐还在滴水。"}]}}
{"kind": "author", "type": "rule", "body": {"id": "缓过来", "every": {"ticks": 12}, "for_each": {"kind": "agent"}, "set": {"体力": "min(体力 + 8 * dt, 100)"}}}
{"kind": "author", "type": "rule", "body": {"id": "熬夜攒睡眠债", "every": {"ticks": 6}, "for_each": {"not_action": "sleep"}, "set": {"睡眠债": "clamp(睡眠债 + (0.008 if (hour >= 23 or hour < 6) else -0.004) * dt, 0, 1)"}}}
{"kind": "author", "type": "rule", "body": {"id": "补觉还债", "every": {"ticks": 6}, "for_each": {"action": "sleep"}, "set": {"睡眠债": "max(睡眠债 - 0.02 * dt, 0)"}}}
{"kind": "author", "type": "kind", "body": {"id": "agent", "quantities": {"体力": {"default": 100, "visibility": "self", "label": "体力", "unit": "点"}, "手艺": {"default": 1.0, "visibility": "here", "label": "手艺", "bands": [[0, "生手"], [1, "上过手"], [3, "老手"]]}, "主动": {"default": 1.0, "visibility": "self", "label": "主动", "unit": "", "bands": [[0, "不太主动"], [0.4, "看情况"], [0.7, "挺主动"]]}, "睡眠债": {"default": 0.0, "visibility": "self", "label": "睡眠债", "unit": "", "bands": [[0, "睡得够"], [0.3, "有点困"], [0.7, "睁不开眼"]]}, "随和": {"default": 1.0, "visibility": "self", "label": "随和", "unit": "", "bands": [[0, "有点拧"], [0.4, "还算好说话"], [0.7, "随和"]]}}}}
{"kind": "author", "type": "kind", "body": {"id": "tree", "gloss": "一棵树", "quantities": {"树高": {"default": 1.0, "visibility": "here", "label": "树高", "unit": "米", "bands": [[0, "刚出土的苗"], [2, "齐人高"], [5, "高过屋檐"], [10, "树冠遮住半条街"]]}, "生长速度": 0.004, "最大树高": 12}, "affordances": {"look": {}, "tend": {"when": ["树高 < 最大树高"], "requires": ["me_体力 >= 15", "have_garden_shears >= 1"], "set": {"树高": "min(树高 + 0.05 * me_手艺, 最大树高)"}, "costs": {"体力": "me_体力 - 15"}}, "harvest": {"when": ["树高 >= 2"], "requires": ["me_体力 >= 10", "have_garden_shears >= 1"], "consumes": {"fertilizer": 1}, "set": {"树高": "树高 - 0.2"}, "costs": {"体力": "me_体力 - 10"}}, "嫁接": {"duration": 12, "when": ["树高 >= 2"], "requires": ["me_体力 >= 25", "have_garden_shears >= 1"], "set": {"最大树高": "最大树高 + 2"}, "costs": {"体力": "me_体力 - 25"}}, "育苗": {"duration": 24, "when": ["树高 >= 3"], "requires": ["me_体力 >= 20", "have_garden_shears >= 1"], "consumes": {"fertilizer": 1}, "costs": {"体力": "me_体力 - 20"}, "spawn": {"kind": "sapling", "name": "新育的树苗"}, "importance": 0.8}, "树下小坐": {"label": "在树下坐会儿", "participants": {"min": 1, "max": 2}, "duration": 6, "requires": ["me_体力 >= 5"], "costs": {"体力": "me_体力 - 5"}, "importance": 0.6}}, "prompt": {"budget": 3}}}
{"kind": "author", "type": "kind", "body": {"id": "sapling", "gloss": "一株齐膝高的树苗,叶子还嫩", "quantities": {"苗高": {"default": 0.2, "visibility": "here", "unit": "米"}}, "affordances": {"look": {}, "拔掉": {"requires": ["me_体力 >= 5"], "costs": {"体力": "me_体力 - 5"}, "destroys_target": true}}, "prompt": {"budget": 3}}}
{"kind": "author", "type": "entity", "body": {"id": "tree:harbor_oak", "name": "门口那棵老橡树", "gloss": "树冠遮住半条街,枝上系着褪色的红布条", "location": "cafe"}}
{"kind": "author", "type": "visibility", "body": {"kind": "world", "key": "季节", "visible": "public"}}
{"kind": "author", "type": "visibility", "body": {"kind": "world", "key": "雨天数", "visible": "public"}}
{"kind": "author", "type": "visibility", "body": {"kind": "world", "key": "雨势", "visible": "public", "label": "雨", "bands": [[0, "天是干的"], [0.15, "毛毛雨"], [0.45, "下得不小"], [0.8, "瓢泼大雨"]]}}
{"kind": "author", "type": "guidance", "body": {"themes": ["手艺与耐心", "小镇上的人情"], "cast_pool": ["夏", "柔"], "forbidden": {"agents": [], "locations": [], "ops": ["agent_leave"], "text": ["不许让任何人离开旧港 —— 这是一个关于留下来的故事", "不许写病痛与死亡"]}, "tone": "海边小镇的慢:话不多,活儿细,善意藏在动作里。", "pacing": {"ceiling": 0.6, "target_curve": {"setup": 1, "escalation": 3, "climax": 5}}, "arcs": [{"id": "那棵老橡树", "milestone": [{"pred": "has_item", "agent": "player", "item": "garden_shears"}], "steer": "他手上有了园艺剪之后,让夏提一句这棵树的来历 —— 别直接讲完,留半句。"}]}}
