        "最大树高": 12
      }
    }
  ],
  "rules": [
    {
      "id": "tree_growth",
      "every": {
        "days": 1
      },
      "for_each": {
        "kind": "tree"
      },
      "when": [
        "world_季节 != 4"
      ],
      "set": {
        "树高": "min(树高 + 生长速度 * dt, 最大树高)"
      },
      "emit": [
        {
          "when": "树高 >= 最大树高",
          "type": "tree_matured"
        }
      ]
    },
    {
      "id": "rainy_days",
      "every": {
        "days": 1
      },
      "for_each": {
        "owner": "world"
      },
      "set": {
        "雨天数": "雨天数 + 1"
      }
    }
  ],
